# ================================================================
# AapdaSetu — Environment Configuration (Optional)
# None of these variables are required. Everything has built-in defaults.
# No API keys, cloud tokens, or database credentials are needed.
# ================================================================

# Friendly station display name
NODE_NAME=AapdaSetu-Node

# Local REST API port for frontend web client
HTTP_PORT=8080

# P2P mesh port for direct libp2p TCP connections
P2P_PORT=9000

# mDNS discovery service name (peers must share this to auto-discover)
MDNS_RENDEZVOUS=aapdasetu-emergency-net

# PubSub GossipSub topic names
CHAT_TOPIC=aapdasetu-chat
ALERT_TOPIC=aapdasetu-alert

# Optional bootstrap peer to connect directly on startup
# Example: /ip4/192.168.1.50/tcp/9000/p2p/12D3KooW...
BOOTSTRAP_PEER=
