# Multi-stage build for Go AapdaSetu node
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git gcc musl-dev

# Download dependencies
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Copy backend source code
COPY backend/ ./

# Build static binary
RUN CGO_ENABLED=1 GOOS=linux go build -a -ldflags '-linkmode external -extldflags "-static"' -o aapdasetu-node ./cmd/node

# Final lightweight runner image
FROM alpine:3.20

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /app/aapdasetu-node /app/aapdasetu-node

# Expose HTTP API and P2P ports
EXPOSE 8080
EXPOSE 9000

ENV HTTP_PORT=8080 \
    P2P_PORT=9000 \
    MDNS_RENDEZVOUS=aapdasetu-emergency-net \
    NODE_NAME="AapdaSetu-Docker-Node"

ENTRYPOINT ["/app/aapdasetu-node"]
